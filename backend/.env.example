PORT=3006
# Obligatorio, mínimo 32 caracteres. Generalo con: openssl rand -hex 32
# (el backend no arranca si queda vacío o con un valor de ejemplo)
JWT_SECRET=
DB_HOST=localhost
DB_USER=gungnir
DB_PASSWORD=
DB_NAME=allsafe_gungnir
CORS_ORIGIN=http://localhost:5176
NODE_ENV=development

# Contraseña inicial de la cuenta "admin", solo en el primer arranque (tabla de usuarios vacía).
# Si queda vacía se genera una aleatoria y se muestra una vez en el log. El primer ingreso obliga
# a cambiarla.
# ADMIN_PASSWORD_INICIAL=

# ── Avisos de hallazgos (opcional) ────────────────────────────────────────────
# SMTP para los avisos por correo. Sin estas variables, el aviso por correo no se envía
# (el webhook sigue funcionando). APP_URL arma el enlace al engagement en el aviso.
APP_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "organization": "GitHub",
          "semanticVersion": "2.19.3",
          "notifications": [],
          "rules": [
            {
              "id": "js/sql-injection",
              "name": "js/sql-injection",
              "shortDescription": { "text": "Database query built from user-controlled sources" },
              "fullDescription": { "text": "Building a database query from user-controlled sources is vulnerable to insertion of malicious code by the user." },
              "defaultConfiguration": { "enabled": true, "level": "error" },
              "help": { "text": "If a database query is built from user-provided data without sufficient sanitization, a malicious user may be able to run malicious database queries. Use a parameterized query.", "markdown": "Use a parameterized query." },
              "properties": { "tags": ["security", "external/cwe/cwe-089", "external/cwe/cwe-090", "external/cwe/cwe-943"], "description": "Building a database query from user-controlled sources is vulnerable to insertion of malicious code by the user.", "id": "js/sql-injection", "kind": "path-problem", "name": "Database query built from user-controlled sources", "precision": "high", "problem.severity": "error", "security-severity": "8.8" }
            },
            {
              "id": "js/reflected-xss",
              "name": "js/reflected-xss",
              "shortDescription": { "text": "Reflected cross-site scripting" },
              "fullDescription": { "text": "Writing user input directly to an HTTP response allows for a cross-site scripting vulnerability." },
              "defaultConfiguration": { "enabled": true, "level": "error" },
              "help": { "text": "Sanitize the input before writing it to the response, or use a template engine that escapes it.", "markdown": "Sanitize the input." },
              "properties": { "tags": ["security", "external/cwe/cwe-079", "external/cwe/cwe-116"], "kind": "path-problem", "precision": "high", "problem.severity": "error", "security-severity": "6.1" }
            },
            {
              "id": "js/path-injection",
              "name": "js/path-injection",
              "shortDescription": { "text": "Uncontrolled data used in path expression" },
              "fullDescription": { "text": "Accessing paths influenced by users can allow an attacker to access unexpected resources." },
              "defaultConfiguration": { "enabled": true, "level": "error" },
              "properties": { "tags": ["security", "external/cwe/cwe-022", "external/cwe/cwe-023"], "kind": "path-problem", "precision": "high", "security-severity": "7.5" }
            }
          ]
        }
      },
      "versionControlProvenance": [
        { "repositoryUri": "https://github.com/ejemplo-org/tienda-web.git", "revisionId": "9f1c2e7b4a3d5e6f7a8b9c0d1e2f3a4b5c6d7e8f", "branch": "refs/heads/main" }
      ],
      "artifacts": [
        { "location": { "uri": "src/db/pedidos.js", "uriBaseId": "%SRCROOT%", "index": 0 } }
      ],
      "results": [
        {
          "ruleId": "js/sql-injection",
          "ruleIndex": 0,
          "rule": { "id": "js/sql-injection", "index": 0 },
          "message": { "text": "This query string depends on a [user-provided value](1)." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "src/db/pedidos.js", "uriBaseId": "%SRCROOT%", "index": 0 }, "region": { "startLine": 42, "startColumn": 32, "endColumn": 71 } } }
          ],
          "partialFingerprints": { "primaryLocationLineHash": "8a3f1c2d9e7b6a54:1", "primaryLocationStartColumnFingerprint": "27" }
        }
      ],
      "columnKind": "utf16CodeUnits",
      "properties": { "semmle.formatSpecifier": "sarif-latest" }
    }
  ]
}
